
{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/mysql2/**",
          "DB/**",
          "src/**",
          "config/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }]
}

