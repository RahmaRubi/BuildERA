PORT=3000

# Database — MySQL connection string
# Local:      mysql://root:password@localhost:3306/BuildERA
# Production: mysql://user:password@host:4000/database  (TiDB Cloud)
DB_URL=mysql://root:password@localhost:3306/BuildERA

# Encryption key for phone numbers (any random long string)
CRYPTO_KEY=your_random_crypto_key_here

# JWT secret (any random long string)
JWT_SECRET=your_random_jwt_secret_here

# Nodemailer — use a Gmail App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Frontend URL for CORS (set to your deployed frontend URL in production)
FRONTEND_URL=http://localhost:5173
